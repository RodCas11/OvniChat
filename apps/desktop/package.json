{
  "name": "@disco-voador/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop composition boundary: Main/Preload/Renderer application shell.",
  "type": "module",
  "scripts": {
    "build": "tsc -b --pretty false",
    "e2e:authorization": "node scripts/e2e-authorization.mjs",
    "e2e:camera-smoke": "node scripts/e2e-camera-smoke.mjs",
    "e2e:connection-smoke": "node scripts/e2e-connection-smoke.mjs",
    "e2e:identity-auth": "node scripts/e2e-identity-auth.mjs",
    "e2e:identity-persistence": "node scripts/e2e-identity-persistence.mjs",
    "e2e:reconnect-smoke": "node scripts/e2e-reconnect-smoke.mjs",
    "e2e:screen-audio-smoke": "node scripts/e2e-screen-audio-smoke.mjs",
    "e2e:screen-smoke": "node scripts/e2e-screen-smoke.mjs",
    "e2e:settings-persistence": "node scripts/e2e-settings-persistence.mjs",
    "e2e:text-chat-persistence": "node scripts/e2e-text-chat-persistence.mjs",
    "e2e:voice-smoke": "node scripts/e2e-voice-smoke.mjs",
    "package": "electron-forge package",
    "smoke": "node scripts/smoke.mjs",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false"
  },
  "main": ".vite/build/main.cjs",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@disco-voador/config": "workspace:*",
    "@disco-voador/identity": "workspace:*",
    "@disco-voador/media-core": "workspace:*",
    "@disco-voador/protocol": "workspace:*",
    "@disco-voador/rtc-core": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
