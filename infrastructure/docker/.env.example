# Environment values for compose.server.example.yaml / compose.self-hosted.example.yaml's
# chantivo-server service. Copy this file to `.env` (ignored — see repo-root .gitignore) in this
# same directory and replace placeholders. NEVER commit a real .env file or a real value for
# DISCO_VOADOR_TURN_SHARED_SECRET anywhere. Run `pnpm verify:secrets` before committing if unsure.
#
# Every value below is optional; the Dedicated Server has safe defaults for all of them (see
# docs/CONFIGURATION.md). Uncomment and set only what this deployment actually needs.

# --- Server identity / display (not secret) ---

# Operator-facing server name, shown to connecting clients. Defaults to "Chantivo Server".
# DISCO_VOADOR_SERVER_NAME=My Chantivo Server

# Display-only address told to operators/clients (e.g. for a manual "server address" field or
# invite text) — never used for binding. Leave unset if unsure.
# DISCO_VOADOR_SERVER_PUBLIC_HOST=chantivo.example.invalid

# 'open' (default) admits any client with no invite; 'invite-only' requires a redeemed token first.
# See docs/architecture/SERVER_AUTHORIZATION.md.
# DISCO_VOADOR_SERVER_ACCESS_MODE=open

# --- Data directory ---
#
# Deliberately NOT set here: the Dockerfile pins DISCO_VOADOR_SERVER_DATA_DIR=/data to match the
# named volume this Compose file mounts at /data. Do not override it from this file — doing so
# would silently point the container at a path with no persistent volume behind it, and SQLite
# state (authorization.sqlite, chat.sqlite, channels.sqlite, profiles.sqlite) would be lost on
# every container recreation.

# --- Realtime/protocol tuning (not secret; safe to leave at defaults) ---
# See docs/CONFIGURATION.md's "Realtime service values" table for the full list and defaults.
# Do not change REALTIME_PORT here without also updating the `ports:`/EXPOSE mapping in
# compose.server.example.yaml and the Dockerfile — they assume 8090.
# REALTIME_MAX_CONNECTIONS=1000
# LOG_LEVEL=info

# --- TURN (Coturn) credential minting — OPTIONAL, only for a deployment that also runs Coturn ---
#
# Both of the following must be set together, or neither at all (docs/CONFIGURATION.md). A
# self-hosted deployment with no TURN relay (STUN/P2P only) is fully supported without these.
#
# DISCO_VOADOR_TURN_SHARED_SECRET is the Coturn `use-auth-secret` REST shared secret. It is a real
# secret: generate it with the operator's own secret mechanism (e.g. `openssl rand -hex 32`), put
# the SAME value into the operator's own ignored infrastructure/coturn/turnserver.conf's
# `static-auth-secret`, and set it here only in an ignored, access-restricted `.env` — never in
# this example file, Compose YAML committed to source control, a command line, or a log.
# DISCO_VOADOR_TURN_SHARED_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_NEVER_COMMITTED

# Comma-separated turn:/turns: URIs the minted credentials are handed back with, matching the
# Coturn service's own advertised address (see compose.self-hosted.example.yaml / the coturn
# templates). Example placeholder only — replace with the real deployment's reachable address.
# DISCO_VOADOR_TURN_URLS=turn:turn.example.invalid:3478

# Credential lifetime in seconds. Defaults to 21600 (6 hours).
# DISCO_VOADOR_TURN_CREDENTIAL_TTL_SECONDS=21600
