{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/secrets/**)",
      "Read(./infrastructure/coturn/turnserver.conf)",
      "Read(./infrastructure/coturn/turnserver.dev.conf)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  }
}
