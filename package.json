{
  "name": "disco-voador",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering scaffold for a self-hosted Windows desktop communication application.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "audit": "corepack pnpm audit --audit-level high",
    "build": "tsc -b --pretty false",
    "check": "prettier --check . && eslint . && tsc --noEmit -p tsconfig.typecheck.json --pretty false && vitest run && tsc -b --pretty false && node scripts/verify-repository.mjs && corepack pnpm audit --audit-level high",
    "clean": "node scripts/clean.mjs",
    "dev": "corepack pnpm --filter @disco-voador/desktop run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json --pretty false",
    "verify": "node scripts/verify-repository.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:infrastructure": "node scripts/verify-infrastructure.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
